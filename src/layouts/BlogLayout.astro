---
import "@fontsource-variable/inter";
import "~/styles/index.css";
import "~/styles/blog.css";
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: "website" | "article";
  lang?: "en" | "it";
  publishedAt?: Date;
  updatedAt?: Date;
}
const { title, description, canonicalPath, type = "website", lang = "en", publishedAt, updatedAt } = Astro.props;
const base = Astro.site ?? new URL("https://donatomolino.it");
const canonical = new URL(canonicalPath, base).toString();
const socialImage = new URL("/og.png", base).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Donato Molino</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {type === "article" && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      inLanguage: lang,
      url: canonical,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { "@type": "Person", name: "Donato Molino", url: new URL("/", base).toString() },
      image: socialImage,
    })} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
  </head>
  <body class="home-page blog-page">
    <a class="blog-skip" href="#main-content">Skip to content</a>
    <header class="home-header blog-header">
      <a class="home-brand" href="/" aria-label="Donato Molino home">
        <span class="signal-square" aria-hidden="true"></span><span>Donato Molino</span>
      </a>
      <p class="home-role">Product Engineer<br />Based in Italy</p>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/manifesto">Manifesto</a>
        <a href="/blog/" aria-current="page">Blog</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="home-footer blog-footer">
      <p>© {new Date().getFullYear()} Donato Molino</p>
      <div class="social-links">
        <a href="https://github.com/donatomolino" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/donatomolino-full-stack/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://x.com/donatomolinox" target="_blank" rel="noreferrer">X</a>
        <a href="https://t.me/dork382/" target="_blank" rel="noreferrer">Telegram</a>
      </div>
      <a href="/">Back to home ↗</a>
    </footer>
  </body>
</html>
