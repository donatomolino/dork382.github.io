---
import "@fontsource-variable/inter";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import swooshManiaImage from "~/content/showcase/_images/swooshmania.jpg";
import BrandMark from "~/components/BrandMark.astro";
import "~/styles/index.css";
import "~/styles/swiss-refinement.css";
import "~/styles/swiss-cobalt.css";
import "~/styles/brand-mark.css";
import "~/styles/featured-product.css";

const { generator, site } = Astro;
const description =
  "Donato Molino is a product engineer who turns ambitious ideas into simple, useful and enduring digital products.";
const socialImage = new URL("/og.png", site);

const homepageUrl = new URL("/", site).toString();
const personId = homepageUrl + "#donato-molino";
const siteGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": homepageUrl + "#website",
      url: homepageUrl,
      name: "Donato Molino",
      description,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Donato Molino",
      url: homepageUrl,
      jobTitle: "Product Engineer",
      description,
      knowsAbout: [
        "Full-stack development",
        "Product engineering",
        "TypeScript",
        "React",
        "Node.js",
        "Artificial intelligence",
        "Unity",
      ],
      sameAs: [
        "https://github.com/donatomolino",
        "https://www.linkedin.com/in/donatomolino-full-stack/",
        "https://x.com/donatomolinox",
      ],
    },
  ],
}).replace(/</g, "\\u003c");


// Last figures explicitly reported in September 2026; these are not live Steamworks metrics.
const swooshMania = {
  steamUrl: "https://store.steampowered.com/app/3560590/SwooshMania/",
  demoPlayers: 300,
  approximateWishlists: 300,
  metricsAsOf: "September 2026",
  plannedRelease: "2027",
};

const latestPosts = (await getCollection("blog", ({ data }) =>
  !data.draft && data.lang === "en" && data.pubDate <= new Date()
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const journalDate = (date: Date) => new Intl.DateTimeFormat("en-GB", {
  day: "2-digit", month: "short", year: "numeric", timeZone: "UTC",
}).format(date);

const capabilities = [
  {
    number: "01",
    title: "Product Engineering",
    items: ["TypeScript", "React", "Next.js", "Astro", "Product UI"],
  },
  {
    number: "02",
    title: "Systems & Backend",
    items: ["Node.js", "Python", "Rust", "PostgreSQL", "API Design"],
  },
  {
    number: "03",
    title: "Cloud & Delivery",
    items: ["Cloudflare", "AWS", "Supabase", "Docker", "CI/CD"],
  },
  {
    number: "04",
    title: "Games & Experiments",
    items: ["Unity", "SteamWorks", "Three.js", "Prototyping", "AI"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg?v=squircle" type="image/svg+xml" />
    <meta name="generator" content={generator} />
    <title>Donato Molino — Product Engineer</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="author" content="Donato Molino" />
    <meta property="og:site_name" content="Donato Molino" />
    <script type="application/ld+json" set:html={siteGraph} />
    <link rel="canonical" href={homepageUrl} />
    <meta property="og:title" content="Donato Molino — Product Engineer" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="home-page">
    <a class="home-skip-link" href="#top">Skip to content</a>
    <header class="home-header">
      <a class="home-brand" href="#top" aria-label="Donato Molino, back to top">
        <BrandMark />
        <span>Donato Molino</span>
      </a>
      <p class="home-role">Product Engineer<br />Based in Italy</p>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="/manifesto">Manifesto</a>
        <a href="/blog/">Blog</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="home-hero" aria-labelledby="home-title">
        <p class="kicker">Independent builder · Full-stack developer</p>
        <h1 id="home-title">
          <span>Donato</span>
          <span class="red">Molino</span>
        </h1>
        <div class="hero-squircle" aria-hidden="true"><span></span></div>
        <p class="hero-copy">
          I turn ambitious ideas into products that feel simple, useful and
          inevitable.
        </p>
        <div class="hero-meta" aria-label="Professional focus">
          <span>Digital Products</span>
          <span>Systems</span>
          <span>Experiments</span>
        </div>
        <a class="scroll-cue" href="#work">Selected work ↓</a>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <header class="section-header">
          <p>01 / Featured product</p>
          <h2 id="work-title">Things made<br />to exist.</h2>
          <p class="section-count">01 product</p>
        </header>

        <article class="featured-product" aria-labelledby="swooshmania-title">
          <a class="featured-product-visual" href="/swooshmania/" aria-label="Discover SwooshMania">
            <Image
              src={swooshManiaImage}
              alt="SwooshMania — 3D time-trial game"
              widths={[640, 960, 1440]}
              sizes="(min-width: 760px) 55vw, 100vw"
              loading="lazy"
            />
            <span class="featured-product-number" aria-hidden="true">01</span>
          </a>
          <div class="featured-product-content">
            <p class="featured-product-eyebrow">Independent game / Unity · Steam</p>
            <h3 id="swooshmania-title">SwooshMania<span class="featured-product-dot">.</span></h3>
            <p class="featured-product-description">
              A fast-paced 3D time-trial game built around precision, momentum and
              leaderboards. A playable demo is available on Steam.
            </p>
            <dl class="featured-product-stats" aria-label="Project progress">
              <div>
                <dd>{swooshMania.demoPlayers}</dd>
                <dt>Unique demo players</dt>
              </div>
              <div>
                <dd>≈{swooshMania.approximateWishlists}</dd>
                <dt>Steam wishlists</dt>
              </div>
              <div>
                <dd>{swooshMania.plannedRelease}</dd>
                <dt>Planned release</dt>
              </div>
            </dl>
            <p class="featured-product-note">
              Player and wishlist figures last reported {swooshMania.metricsAsOf}; not live counts.
            </p>
            <div class="featured-product-actions">
              <a class="featured-product-primary" href={swooshMania.steamUrl} target="_blank" rel="noopener noreferrer">
                Wishlist on Steam <span aria-hidden="true">↗</span>
              </a>
              <a class="featured-product-secondary" href="/swooshmania/">
                Explore the game <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      </section>

      {latestPosts.length > 0 && (
        <section class="journal-section" id="writing" aria-labelledby="journal-title">
          <div class="journal-heading">
            <p class="journal-eyebrow">02 / Journal</p>
            <h2 id="journal-title">Ideas.<br /><span>In progress.</span></h2>
            <a href="/blog/" class="journal-more">All articles <span aria-hidden="true">↗</span></a>
          </div>
          <div class="journal-list">
            {latestPosts.map((post, index) => (
              <a class="journal-row" href={"/blog/en/" + post.data.slug + "/"}>
                <time datetime={post.data.pubDate.toISOString()}>{journalDate(post.data.pubDate)}</time>
                <div class="journal-row-content">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="journal-tag">{post.data.tags[0] ?? "Editorial"}</span>
                </div>
                <span class="journal-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="manifesto-callout" aria-labelledby="manifesto-heading">
        <div class="manifesto-label">03 / Principles</div>
        <h2 id="manifesto-heading">
          The Donnie<br />Manifesto
        </h2>
        <p>We are here to build what should exist.</p>
        <a href="/manifesto">Read the ten principles <span aria-hidden="true">→</span></a>
      </section>

      <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title">
        <header class="section-header section-header--compact">
          <p>04 / Capabilities</p>
          <h2 id="capabilities-title">The stack changes.<br />The standard doesn’t.</h2>
        </header>
        <div class="capabilities-grid">
          {
            capabilities.map((capability) => (
              <article>
                <span>{capability.number}</span>
                <h3>{capability.title}</h3>
                <ul>
                  {capability.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <p class="about-label">05 / About</p>
        <h2 id="about-title">
          Code is a tool.<br />The product is the point.
        </h2>
        <div class="about-copy">
          <p>
            I’m a full-stack developer focused on turning ideas into real
            products through sound architecture, open collaboration and close
            attention to the people who use them.
          </p>
          <p>
            From aerospace R&amp;D prototypes to multi-tenant commerce platforms
            and independent games, I take work from the first sketch to a
            dependable release.
          </p>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <p>06 / Start something</p>
        <h2 id="contact-title">Have an idea<br />worth building?</h2>
        <details class="contact-disclosure">
          <summary class="contact-link">
            Let’s talk <span aria-hidden="true" class="contact-disclosure-indicator">+</span>
          </summary>
          <div class="contact-methods" aria-label="Ways to get in touch">
            <a class="contact-method" href="mailto:donatomolino@proton.me">
              <span class="contact-method-label">01 / Email</span>
              <span class="contact-method-value">donatomolino@proton.me</span>
              <span class="contact-method-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="contact-method" href="https://t.me/dork382/" target="_blank" rel="noopener noreferrer">
              <span class="contact-method-label">02 / Telegram</span>
              <span class="contact-method-value">@dork382</span>
              <span class="contact-method-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="contact-method contact-method--static">
              <span class="contact-method-label">03 / Discord</span>
              <span class="contact-method-value">dork382</span>
              <span class="contact-method-note">Add friend on Discord</span>
            </div>
          </div>
        </details>
      </section>
    </main>

    <footer class="home-footer">
      <p>© {new Date().getFullYear()} Donato Molino</p>
      <div class="social-links">
        <a href="https://github.com/donatomolino" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/donatomolino-full-stack/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://x.com/donatomolinox" target="_blank" rel="noreferrer">X</a>
        <a href="https://t.me/dork382/" target="_blank" rel="noreferrer">Telegram</a>
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
