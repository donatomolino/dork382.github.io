---
import { getCollection } from "astro:content";
import BlogLayout from "~/layouts/BlogLayout.astro";

export const prerender = true;
export function getStaticPaths() {
  return [{ params: { lang: "it" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as "it" | "en";
const t = lang === "it" ? {
  title: "Appunti sul futuro.",
  eyebrow: "01 / Scrittura",
  tag: "Idee, esperimenti e prospettive",
  description: "Note su quello che costruisco, le idee che provo e ciò che penso possa arrivare dopo.",
  journal: "Donato Molino / Diario",
  all: "Tutti gli articoli",
  entry: "articoli",
  empty: "Il primo articolo è in preparazione.",
  emptyBody: "Questo spazio raccoglierà idee, esperimenti e appunti dal lavoro.",
  start: "02 / Da dove iniziare",
  end: "Meno rumore. Più cose reali.",
  manifesto: "Leggi il manifesto",
  seo: "Pensieri su ingegneria del prodotto, software, AI, progetti indipendenti e tecnologia.",
} : {
  title: "Things worth thinking about.",
  eyebrow: "01 / Writing",
  tag: "Ideas, experiments & perspective",
  description: "Notes from making things. What works, what doesn't, and what might come next.",
  journal: "Donato Molino / Journal",
  all: "All writing",
  entry: "entries",
  empty: "The first note is still being written.",
  emptyBody: "This space is ready for ideas, experiments and things learned along the way.",
  start: "02 / A starting point",
  end: "Less noise. More making.",
  manifesto: "Read the manifesto",
  seo: "Thoughts on product engineering, software, AI, independent projects and technology.",
};
const posts = (await getCollection("blog", ({ data }) =>
  !data.draft && data.lang === lang && data.pubDate <= new Date()
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(lang === "it" ? "it-IT" : "en-GB", {
    day: "2-digit", month: "short", year: "numeric", timeZone: "UTC",
  }).format(date);
---
<BlogLayout
  lang={lang}
  title={lang === "it" ? "Blog" : "Blog"}
  description={t.seo}
  canonicalPath={"/blog/" + lang + "/"}
  alternatePath={"/blog/" + (lang === "it" ? "en" : "it") + "/"}
>
  <section class="blog-hero" aria-labelledby="blog-title">
    <div class="blog-hero-top">
      <p>{t.eyebrow}</p><p>{t.tag}</p>
    </div>
    <h1 id="blog-title">{t.title}</h1>
    <div class="blog-hero-bottom">
      <p>{t.description}</p><span>{t.journal}</span>
    </div>
  </section>
  <section class="blog-index" aria-labelledby="posts-title">
    <div class="blog-index-heading">
      <h2 id="posts-title">{t.all}<span class="blog-red">.</span></h2>
      <span>{posts.length.toString().padStart(2, "0")} {t.entry}</span>
    </div>
    {posts.length > 0 ? (
      <div class="blog-post-list">
        {posts.map((post, index) => (
          <a class="blog-post-row" href={"/blog/" + lang + "/" + post.data.slug + "/"}>
            <span class="blog-row-number">{(index + 1).toString().padStart(2, "0")}</span>
            <div class="blog-row-copy">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="blog-row-tags" aria-label={lang === "it" ? "Argomenti" : "Topics"}>
                  {post.data.tags.map((tag) => <span>{tag}</span>)}
                </div>
              )}
            </div>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span class="blog-row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="blog-empty">
        <h3>{t.empty}</h3><p>{t.emptyBody}</p>
      </div>
    )}
  </section>
  <aside class="blog-endcap">
    <p>{t.start}</p>
    <h2>{t.end}</h2>
    <a href="/manifesto">{t.manifesto} <span aria-hidden="true">↗</span></a>
  </aside>
</BlogLayout>
