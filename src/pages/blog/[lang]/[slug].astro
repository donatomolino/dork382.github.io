---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogLayout from "~/layouts/BlogLayout.astro";
import BlogComments from "~/components/BlogComments.astro";

export const prerender = true;
type Language = "it" | "en";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    !data.draft && data.pubDate <= new Date()
  );
  const paths = await Promise.all(posts.map(async (post) => {
    const others = await getCollection("blog", ({ data }) =>
      !data.draft &&
      data.translationKey === post.data.translationKey &&
      data.lang !== post.data.lang &&
      data.pubDate <= new Date()
    );
    const alternate = post.data.translationKey
      ? others.find((other) => other.data.translationKey === post.data.translationKey)
      : undefined;

    return {
      params: { lang: post.data.lang, slug: post.data.slug },
      props: { post, alternatePath: alternate
        ? "/blog/" + alternate.data.lang + "/" + alternate.data.slug + "/"
        : undefined },
    };
  }));
  return paths;
}

interface Props {
  post: CollectionEntry<"blog">;
  alternatePath?: string;
}

const { post, alternatePath } = Astro.props;
const lang = post.data.lang as Language;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const t = lang === "it" ? {
  back: "Tutti gli articoli",
  journal: "Diario",
  topics: "Argomenti",
  end: "Fine dell'articolo.",
  more: "Altri articoli",
  onThisPage: "In questo articolo",
  authorIntro: "Scritto da Donato Molino, Product Engineer e sviluppatore indipendente.",
  authorLink: "Altri progetti",
} : {
  back: "All writing",
  journal: "Journal",
  topics: "Topics",
  end: "That's the note.",
  more: "More writing",
  onThisPage: "In this article",
  authorIntro: "Written by Donato Molino, product engineer and independent developer.",
  authorLink: "Explore my work",
};
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(lang === "it" ? "it-IT" : "en-GB", {
    day: "2-digit", month: "long", year: "numeric", timeZone: "UTC",
  }).format(date);
---
<BlogLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={"/blog/" + lang + "/" + post.data.slug + "/"}
  alternatePath={alternatePath}
  type="article"
  lang={lang}
  publishedAt={post.data.pubDate}
  updatedAt={post.data.updatedDate}
  tags={post.data.tags}
  sources={post.data.sources}
>
  <article class="blog-article">
    <header class="blog-article-header">
      <a class="blog-back" href={"/blog/" + lang + "/"}>← {t.back}</a>
      <div class="blog-article-meta">
        <span>{t.journal} / Donato Molino</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="blog-article-description">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="blog-article-tags" aria-label={t.topics}>
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>
    {post.data.translationKey === "future-tech" && (
      <aside class="blog-quick-answer" aria-labelledby="blog-quick-answer-title">
        <p class="blog-quick-answer-eyebrow">{lang === "it" ? "In breve / Punto di vista personale" : "In brief / Personal perspective"}</p>
        <h2 id="blog-quick-answer-title">{lang === "it" ? "La mia idea, in sintesi" : "The argument in a nutshell"}</h2>
        <p>{lang === "it"
          ? "Credo che tra il 2027 e il 2050 gli assistenti AI personali, i protocolli aperti e le interfacce dinamiche ridurranno la nostra dipendenza dalle app tradizionali. Smartphone e PC potrebbero convergere; la realtà aumentata indossabile richiederà più tempo. Sono previsioni personali, non fatti accertati."
          : "My bet for 2027–2050 is that personal AI, interoperable protocols and task-specific interfaces will make traditional apps less central. Phones may become desktop computers when connected to a screen, while practical spatial AR will take longer. These are my hypotheses, not established forecasts."}
        </p>
        <p class="blog-quick-answer-note">{lang === "it"
          ? "L'articolo distingue dati osservati, stime degli analisti e scenari ipotetici; le fonti sono citate accanto alle affermazioni."
          : "The article distinguishes observed data, analyst estimates and hypothetical scenarios; primary sources accompany the claims."}
        </p>
        <a href="#blog-quick-answer-context">{lang === "it" ? "Leggi l'analisi completa ↓" : "Read the full argument ↓"}</a>
      </aside>
    )}
    <div id="blog-quick-answer-context"></div>
    {toc.length > 2 && (
      <nav class="blog-article-toc" aria-label={t.onThisPage}>
        <p>{t.onThisPage}</p>
        <ol>
          {toc.map((heading, index) => (
            <li><a href={"#" + heading.slug}>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              {heading.text}
            </a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={["blog-prose", post.data.translationKey === "future-tech" && "blog-prose--future-tech"]}>
      <Content />
    </div>
    <aside class="blog-author-byline">
      <p>{t.authorIntro}</p>
      <a href="/#work">{t.authorLink} <span aria-hidden="true">↗</span></a>
    </aside>
    <BlogComments thread={post.data.translationKey || post.data.slug} lang={lang} />
    <footer class="blog-article-footer">
      <p>{t.end}</p>
      <a href={"/blog/" + lang + "/"}>{t.more} <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</BlogLayout>
