<!--
  Three-second intro bootstrap.
  Decides before first paint, exposes window.donatoIntro, and falls back safely
  if the animated module cannot run. The site itself stays fully server-rendered.
-->
<style is:inline>
  :root {
    --dm-intro-surface: var(--swiss-paper, #f2f1ed);
    --dm-intro-text: var(--swiss-ink, #11110f);
    --dm-intro-accent: #ed1c24;
  }
  html[data-theme="dark"] {
    --dm-intro-surface: #11110f;
    --dm-intro-text: #f2f1ed;
  }
  html.intro body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    background: var(--dm-intro-surface);
    pointer-events: none;
    animation: dm-intro-guard 2s steps(1, end) forwards;
  }
  @keyframes dm-intro-guard {
    to { visibility: hidden; }
  }
  html.intro.intro-running body::before {
    display: none;
  }
</style>
<script is:inline>
  (() => {
    let resolveIntro;
    window.donatoIntro = new Promise((resolve) => { resolveIntro = resolve; });
    window.__donatoIntroResolve = () => {
      if (resolveIntro) {
        resolveIntro();
        resolveIntro = undefined;
      }
    };
    window.__donatoIntroEligible = false;

    try {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          typeof Element.prototype.animate !== "function") {
        window.__donatoIntroResolve();
        return;
      }

      // Storage must be writable; private/restricted browsing must open immediately.
      const key = "dm:site-intro:Europe-Rome";
      const probe = "dm:intro:storage-probe";
      localStorage.setItem(probe, "1");
      localStorage.removeItem(probe);

      const params = new URLSearchParams(location.search);
      if (params.get("intro") === "0") {
        window.__donatoIntroResolve();
        return;
      }
      const forced = params.has("intro");
      const parts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Rome", year: "numeric", month: "2-digit", day: "2-digit"
      }).formatToParts(new Date());
      const datePart = (type) => parts.find((part) => part.type === type)?.value || "";
      const today = datePart("year") + "-" + datePart("month") + "-" + datePart("day");

      if (!forced && localStorage.getItem(key) === today) {
        window.__donatoIntroResolve();
        return;
      }

      localStorage.setItem(key, today);
      window.__donatoIntroEligible = true;
      window.__donatoIntroBootstrapTime = performance.now();
      document.documentElement.classList.add("intro");

      // A second, independent safety net if the deferred module never starts.
      window.setTimeout(() => {
        document.documentElement.classList.remove("intro", "intro-running");
        window.__donatoIntroResolve();
      }, 3350);
    } catch (_error) {
      // Storage, timezone, or browser feature unavailable: render normally.
      window.__donatoIntroEligible = false;
      document.documentElement.classList.remove("intro", "intro-running");
      window.__donatoIntroResolve();
    }
  })();
</script>
