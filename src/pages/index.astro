---
import "@fontsource-variable/inter";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import farmingCatImage from "~/content/showcase/_images/farmingcat.png";
import flowlightImage from "~/content/showcase/_images/flowlight.png";
import postOfficeImage from "~/content/showcase/_images/postoffice.png";
import swooshManiaImage from "~/content/showcase/_images/swooshmania.jpg";
import thinkyImage from "~/content/showcase/_images/thinky.png";
import "~/styles/index.css";
import "~/styles/compact-editorial.css";

const { generator, site } = Astro;
const description =
  "Donato Molino is a product engineer who turns ambitious ideas into simple, useful and enduring digital products.";
const socialImage = new URL("/og.png", site);

const homepageUrl = new URL("/", site).toString();
const personId = homepageUrl + "#donato-molino";
const siteGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": homepageUrl + "#website",
      url: homepageUrl,
      name: "Donato Molino",
      description,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Donato Molino",
      url: homepageUrl,
      jobTitle: "Product Engineer",
      description,
      knowsAbout: [
        "Full-stack development",
        "Product engineering",
        "TypeScript",
        "React",
        "Node.js",
        "Artificial intelligence",
        "Unity",
      ],
      sameAs: [
        "https://github.com/donatomolino",
        "https://www.linkedin.com/in/donatomolino-full-stack/",
        "https://x.com/donatomolinox",
      ],
    },
  ],
}).replace(/</g, "\\u003c");


const projects = [
  {
    title: "FarmingCat",
    type: "Game / Product",
    year: "2022—Now",
    url: "https://store.steampowered.com/app/2003840/FarmingCat/",
    image: farmingCatImage,
  },
  {
    title: "Post Office",
    type: "Platform / Commerce",
    year: "2024",
    url: "https://centroposte.com",
    image: postOfficeImage,
  },
  {
    title: "SwooshMania",
    type: "Game / Product",
    year: "2025",
    url: "/swooshmania/",
    image: swooshManiaImage,
  },
  {
    title: "Thinky",
    type: "AI / Interaction",
    year: "2026",
    url: "/thinky",
    image: thinkyImage,
  },
  {
    title: "Flowlight",
    type: "Experiment / Light",
    year: "2023",
    url: "/e/flowlight",
    image: flowlightImage,
  },
  {
    title: "Junk Feed",
    type: "Writing / Telegram",
    year: "Ongoing",
    url: "/junkfeed",
  },
];

const latestPosts = (await getCollection("blog", ({ data }) =>
  !data.draft && data.lang === "en" && data.pubDate <= new Date()
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 2);
const formatPostDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric", month: "short", year: "numeric", timeZone: "UTC",
  }).format(date);

const capabilities = [
  {
    number: "01",
    title: "Product Engineering",
    items: ["TypeScript", "React", "Next.js", "Astro", "Product UI"],
  },
  {
    number: "02",
    title: "Systems & Backend",
    items: ["Node.js", "Python", "Rust", "PostgreSQL", "API Design"],
  },
  {
    number: "03",
    title: "Cloud & Delivery",
    items: ["Cloudflare", "AWS", "Supabase", "Docker", "CI/CD"],
  },
  {
    number: "04",
    title: "Games & Experiments",
    items: ["Unity", "SteamWorks", "Three.js", "Prototyping", "AI"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={generator} />
    <title>Donato Molino — Product Engineer</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="author" content="Donato Molino" />
    <meta property="og:site_name" content="Donato Molino" />
    <script type="application/ld+json" set:html={siteGraph} />
    <link rel="canonical" href={homepageUrl} />
    <meta property="og:title" content="Donato Molino — Product Engineer" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="home-page">
    <a class="home-skip" href="#top">Skip to content</a>
    <header class="home-header">
      <a class="home-brand" href="#top" aria-label="Donato Molino, back to top">
        <span class="signal-square" aria-hidden="true"></span>
        <span>Donato Molino</span>
      </a>
      <p class="home-role">Product Engineer<br />Based in Italy</p>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="/manifesto">Manifesto</a>
        <a href="/blog/">Blog</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="home-hero" aria-labelledby="home-title">
        <p class="kicker">Independent builder · Full-stack developer</p>
        <h1 id="home-title">
          <span>Donato</span>
          <span class="red">Molino</span>
        </h1>
        <p class="hero-copy">
          I turn ambitious ideas into products that feel simple, useful and
          inevitable.
        </p>
        <div class="hero-meta" aria-label="Professional focus">
          <span>Digital Products</span>
          <span>Systems</span>
          <span>Experiments</span>
        </div>
        <a class="scroll-cue" href="#work">Selected work <span aria-hidden="true">↘</span></a>
        <div class="hero-status" aria-label="Current focus">
          <div>
            <small>Current focus</small>
            <strong>Product engineering + AI</strong>
          </div>
          <svg width="23" height="23" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19 19 5M8 5h11v11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <header class="section-header">
          <p>01 / Selected work</p>
          <h2 id="work-title">Things made<br />to exist.</h2>
          <p class="section-count">06 projects</p>
        </header>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <a
                class:list={["project-card", !project.image && "project-card--type"]}
                href={project.url}
                target={project.url.startsWith("http") ? "_blank" : undefined}
                rel={project.url.startsWith("http") ? "noreferrer" : undefined}
              >
                <div class="project-visual">
                  {project.image ? (
                    <Image src={project.image} alt="" widths={[640, 960]} sizes="(min-width: 1000px) 45vw, (min-width: 680px) 48vw, 100vw" />
                  ) : (
                    <span aria-hidden="true">JF</span>
                  )}
                  <span class="project-index">{(index + 1).toString().padStart(2, "0")}</span>
                </div>
                <div class="project-info">
                  <h3>{project.title}</h3>
                  <p>{project.type}</p>
                  <p>{project.year}</p>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      {latestPosts.length > 0 && (
        <section class="writing-section" id="writing" aria-labelledby="writing-title">
          <header class="writing-heading">
            <div>
              <p>02 / Journal</p>
              <h2 id="writing-title">Recent writing.</h2>
            </div>
            <a href="/blog/" aria-label="See all writing">All articles <span aria-hidden="true">↗</span></a>
          </header>
          <div class="writing-list">
            {latestPosts.map((post) => (
              <a class="writing-card" href={"/blog/en/" + post.data.slug + "/"}>
                <div class="writing-card-top">
                  <span>{post.data.tags[0] ?? "Journal"}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
                </div>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <div class="writing-card-footer">
                  <span>Read the article</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="manifesto-callout" aria-labelledby="manifesto-heading">
        <div class="manifesto-label">03 / Principles</div>
        <h2 id="manifesto-heading">
          The Donnie<br />Manifesto
        </h2>
        <p>We are here to build what should exist.</p>
        <a href="/manifesto">Read the ten principles <span aria-hidden="true">→</span></a>
      </section>

      <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title">
        <header class="section-header section-header--compact">
          <p>04 / Capabilities</p>
          <h2 id="capabilities-title">The stack changes.<br />The standard doesn’t.</h2>
        </header>
        <div class="capabilities-grid">
          {
            capabilities.map((capability) => (
              <article>
                <span>{capability.number}</span>
                <h3>{capability.title}</h3>
                <ul>
                  {capability.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <p class="about-label">05 / About</p>
        <h2 id="about-title">
          Code is a tool.<br />The product is the point.
        </h2>
        <div class="about-copy">
          <p>
            I’m a full-stack developer focused on turning ideas into real
            products through sound architecture, open collaboration and close
            attention to the people who use them.
          </p>
          <p>
            From aerospace R&amp;D prototypes to multi-tenant commerce platforms
            and independent games, I take work from the first sketch to a
            dependable release.
          </p>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <p>06 / Start something</p>
        <h2 id="contact-title">Have an idea<br />worth building?</h2>
        <a class="contact-link" href="mailto:donatomolino@europe.com">
          Let’s talk <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="home-footer">
      <p>© {new Date().getFullYear()} Donato Molino</p>
      <div class="social-links">
        <a href="https://github.com/donatomolino" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/donatomolino-full-stack/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://x.com/donatomolinox" target="_blank" rel="noreferrer">X</a>
        <a href="https://t.me/dork382/" target="_blank" rel="noreferrer">Telegram</a>
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
