---
import "@fontsource-variable/inter";
import "~/styles/index.css";
import "~/styles/blog.css";
import "~/styles/swiss-refinement.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: "website" | "article";
  lang: "en" | "it";
  alternatePath?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  sources?: string[];
  postItems?: { title: string; url: string }[];
}

const {
  title, description, canonicalPath, type = "website", lang, alternatePath,
  publishedAt, updatedAt, tags = [], sources = [], postItems = []
} = Astro.props;

const base = Astro.site ?? new URL("https://donatomolino.it");
const canonical = new URL(canonicalPath, base).toString();
const otherLang = lang === "it" ? "en" : "it";
const alternative = alternatePath ? new URL(alternatePath, base).toString() : undefined;
const socialImagePath = type === "article"
  ? canonicalPath.replace(/^\/blog\//, "/blog/og/").replace(/\/$/, ".png")
  : "/og.png";
const socialImage = new URL(socialImagePath, base).toString();
const blogUrl = new URL("/blog/" + lang + "/", base).toString();
const person = {
  "@type": "Person",
  "@id": new URL("/#donato-molino", base).toString(),
  name: "Donato Molino",
  url: new URL("/", base).toString(),
  jobTitle: "Product Engineer",
  sameAs: [
    "https://github.com/donatomolino",
    "https://www.linkedin.com/in/donatomolino-full-stack/",
    "https://x.com/donatomolinox",
  ],
};
const structuredPage = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonical + "#article",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  headline: title,
  description,
  inLanguage: lang,
  url: canonical,
  datePublished: publishedAt?.toISOString(),
  dateModified: (updatedAt ?? publishedAt)?.toISOString(),
  author: person,
  publisher: person,
  image: socialImage,
  isAccessibleForFree: true,
  isPartOf: { "@type": "Blog", "@id": blogUrl, name: "Donato Molino — Blog" },
  keywords: tags,
  citation: sources,
} : {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": canonical + "#collection",
  url: canonical,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { "@type": "WebSite", "@id": new URL("/#website", base).toString() },
  about: person,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: postItems.map((item, index) => ({
      "@type": "ListItem", position: index + 1, name: item.title, url: new URL(item.url, base).toString(),
    })),
  },
};
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Donato Molino", item: new URL("/", base).toString() },
    { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
    ...(type === "article" ? [{
      "@type": "ListItem", position: 3, name: title, item: canonical,
    }] : []),
  ],
};
const jsonLd = JSON.stringify([structuredPage, breadcrumbs]).replace(/</g, "\\u003c");
const defaultLanguageUrl = type === "article"
  ? (lang === "en" ? canonical : alternative)
  : new URL("/blog/", base).toString();
const t = lang === "it" ? {
  skip: "Vai al contenuto",
  home: "Donato Molino, pagina iniziale",
  work: "Lavori",
  manifesto: "Manifesto",
  contact: "Contatti",
  nav: "Navigazione principale",
  langChoice: "Lingua",
  role: "Ingegnere del prodotto",
  based: "In Italia",
  back: "Torna alla home",
} : {
  skip: "Skip to content",
  home: "Donato Molino, home",
  work: "Work",
  manifesto: "Manifesto",
  contact: "Contact",
  nav: "Main navigation",
  langChoice: "Language",
  role: "Product Engineer",
  based: "Based in Italy",
  back: "Back to home",
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Donato Molino</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="author" content="Donato Molino" />
    <meta property="og:site_name" content="Donato Molino" />
    <link rel="alternate" type="application/rss+xml" title="Donato Molino — Blog RSS" href="/blog/rss.xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {alternative && <link rel="alternate" hreflang={otherLang} href={alternative} />}
    {defaultLanguageUrl && <link rel="alternate" hreflang="x-default" href={defaultLanguageUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    {alternative && <meta property="og:locale:alternate" content={otherLang === "it" ? "it_IT" : "en_US"} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title + " — Donato Molino"} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
  </head>
  <body class="home-page blog-page">
    <a class="blog-skip" href="#main-content">{t.skip}</a>
    <header class="home-header blog-header">
      <a class="home-brand" href="/" aria-label={t.home}>
        <span class="signal-square" aria-hidden="true"></span><span>Donato Molino</span>
      </a>
      <p class="home-role">{t.role}<br />{t.based}</p>
      <nav class="blog-nav" aria-label={t.nav}>
        <a href="/#work">{t.work}</a>
        <a href="/manifesto">{t.manifesto}</a>
        <a href={"/blog/" + lang + "/"} aria-current="page">Blog</a>
        <a href="/#contact">{t.contact}</a>
        <span class="blog-language-switch" role="group" aria-label={t.langChoice}>
          <a href={lang === "it" ? canonicalPath : (alternatePath ?? "/blog/it/")}
            data-blog-language="it"
            lang="it"
            aria-current={lang === "it" ? "true" : undefined}
            aria-label="Italiano">IT</a>
          <span class="blog-language-separator" aria-hidden="true"></span>
          <a href={lang === "en" ? canonicalPath : (alternatePath ?? "/blog/en/")}
            data-blog-language="en"
            lang="en"
            aria-current={lang === "en" ? "true" : undefined}
            aria-label="English">EN</a>
        </span>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="home-footer blog-footer">
      <p>© {new Date().getFullYear()} Donato Molino</p>
      <div class="social-links">
        <a href="https://github.com/donatomolino" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/donatomolino-full-stack/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://x.com/donatomolinox" target="_blank" rel="noreferrer">X</a>
        <a href="https://t.me/dork382/" target="_blank" rel="noreferrer">Telegram</a>
      </div>
      <a href="/">{t.back} <span aria-hidden="true">↗</span></a>
    </footer>
    <script is:inline>
      document.querySelectorAll("[data-blog-language]").forEach((link) => {
        link.addEventListener("click", () => {
          try {
            localStorage.setItem("donatomolino_blog_language", link.getAttribute("data-blog-language"));
          } catch (_error) {
            // Language selection still works when storage is unavailable.
          }
        });
      });
    </script>
  </body>
</html>
